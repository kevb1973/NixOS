bind <RIGHT> feedlist,articlelist open
bind <RIGHT> article open-in-browser
bind <LEFT> everywhere quit
bind a articlelist mark-all-above-as-read -- "Mark all above as read"
#browser "zen --new-tab %u"
browser "firefox-beta %u"
cleanup-on-quit yes
confirm-mark-feed-read no
delete-read-articles-on-quit yes
error-log "~/.local/share/newsboat/error.log"
# miniflux-token "aff720d0867f72c5e9b9bad192b804de7fd41ac1b2f627600c84872919ac8729"
# miniflux-url "http://localhost:3002"
refresh-on-startup no
auto-reload yes
reload-time 60
reload-threads 4
max-items 200
show-read-articles no
show-read-feeds no
# urls-source "miniflux"
articlelist-format "%2i %D %t"
feedlist-format "%2n %11u %t"
color listfocus_unread black blue
color title black blue
color info black blue
