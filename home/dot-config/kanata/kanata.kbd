(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =   bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]   \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft        up        
  lctl lmet lalt           spc                       rctl      left down rght 
)

(deflayer qwerty
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =   bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]   \
  @ms2  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft          up        
  lctl lmet lalt         spc                       rctl          left down rght 
)

(defalias
  msq (layer-switch qwerty)
  ms1 (layer-switch mouse-spd-1)
  ms2 (layer-switch mouse-spd-2)
  ms3 (layer-switch mouse-spd-3)
  msr (layer-switch mouse-scroll)
  msrf (layer-while-held mouse-scroll-fast)
  mst (layer-while-held mouse-scroll)
  msa (layer-while-held qwerty)
)

(defalias
  ms↑ (mwheel-up 10 12)
  ms↓ (mwheel-down 10 12)
  msf↑ (mwheel-up 10 36)
  msf↓ (mwheel-down 10 36)
  mwl (mwheel-left 50 120)
  mwr (mwheel-right 50 120)
  slw (movemouse-speed 40)
  fst (movemouse-speed 175)
  sp1↑ (movemouse-up 10 2)
  sp1← (movemouse-left 10 2)
  sp1↓ (movemouse-down 10 2)
  sp1→ (movemouse-right 10 2)
  sp2↑ (movemouse-up 10 5)
  sp2← (movemouse-left 10 5)
  sp2↓ (movemouse-down 10 5)
  sp2→ (movemouse-right 10 5)
  sp3↑ (movemouse-up 10 8)
  sp3← (movemouse-left 10 8)
  sp3↓ (movemouse-down 10 8)
  sp3→ (movemouse-right 10 8)
  hbk A-ArrowLeft
  hfw A-right
)

(deflayer mouse-spd-1
_    _    _    _    _    _    _    _    _    _    _    _    _
_    _  @ms2 @ms3   _    _    _    _    _    _    _    _    _    _
_    _  @fst @slw  mmid  _    _    _    _    _    _    _  mmid mrgt
@msq _  @msr   _   mlft mrgt  _    _    _    _    _    _  mlft
@mst _    _    _    _    _    _    _    _  lrld  @hfw  @mst          @sp1↑
_    _    _             @msr                     @hbk         @sp1←  @sp1↓ @sp1→
)

(deflayer mouse-spd-2
_    _    _    _    _    _    _    _    _    _    _    _    _
_  @ms1   _  @ms3   _    _    _    _    _    _    _    _    _    _
_    _  @fst @slw  mmid  _    _    _    _    _    _    _  mmid mrgt
@msq _  @msr   _   mlft mrgt  _    _    _    _    _    _  mlft
@mst _    _    _    _    _    _    _    _  lrld  @hfw  @mst           @sp2↑
_    _    _              @msr                     @hbk         @sp2←  @sp2↓ @sp2→
)

(deflayer mouse-spd-3
 _    _    _    _    _    _    _    _    _    _    _    _    _
 _  @ms1 @ms2   _    _    _    _    _    _    _    _    _    _    _
 _    _  @fst @slw  mmid  _    _    _    _    _    _    _   mmid mrgt
 @msq _  @msr   _   mlft mrgt  _    _    _    _    _    _   mlft
 @mst _    _    _    _    _    _    _    _  lrld  @hfw  @mst          @sp3↑
 _    _    _             @msr                     @hbk         @sp3←  @sp3↓ @sp3→
 )

(deflayer mouse-scroll
_     _    _    _    _    _    _    _    _    _    _    _    _
_     _    _    _    _    _    _    _    _    _    _    _    _    _
_     _    _    _  mmid   _    _    _    _    _    _    _    _    _
@msq  _  @ms2   _  mlft mrgt   _    _    _    _    _    _  mlft
@msrf _    _    _    _    _    _    _    _    _   @hfw  @msrf         @ms↑
_     _    _             @ms2                     @hbk         @mwl   @ms↓  @mwr
)

(deflayer mouse-scroll-fast
_    _    _    _    _    _    _    _    _    _    _    _    _
_    _    _    _    _    _    _    _    _    _    _    _    _    _
_    _    _    _  mmid   _    _    _    _    _    _    _    _    _
@msq _  @ms2   _  mlft mrgt   _    _    _    _    _    _  mlft
@ms2 _    _    _    _    _    _    _    _    _   @hfw  _             @msf↑
_    _    _             @ms2                     @hbk         @mwl   @msf↓  @mwr
)
