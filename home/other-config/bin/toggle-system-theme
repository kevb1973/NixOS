#!/usr/bin/env bash
set -x
noctalia=$(noctalia msg theme-mode-get)

case "$noctalia" in
light)
  dconf write /org/gnome/desktop/interface/color-scheme "'prefer-light'"
  ;;
dark)
  dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
  ;;
esac

# systemctl --user restart xdg-desktop-portal.service --ignore-dependencies
