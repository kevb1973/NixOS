store=$(sudo dust -o gb -j -D /nix/store | jq -r '.size') # -r gives raw string
var=$(sudo dust -j -o gb -X /var/tmp -D /var | jq -r '.size')

printf '%s\n' "╭─────────────────────────────╮"
printf '│ %-21s %5s │\n' "Halcyon System Size" "Size"
printf '%s\n' "├─────────────────────────────┤"
printf '│ %-21s %5s │\n' "/nix/store" "$store"
printf '│ %-21s %5s │\n' "/var" "$var"
printf '%s\n' "╰─────────────────────────────╯"
